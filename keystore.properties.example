# Copy this file to keystore.properties and keep the copy untracked.
# Restore the existing Archive signing key first. Do not generate a replacement.
# Use an absolute path with forward slashes on Windows.
storeFile=C:/secure/path/to/archive-existing-signing-key.keystore
storePassword=<retrieve-from-password-manager>
keyAlias=<existing-key-alias>
keyPassword=<retrieve-from-password-manager>

# Instead of this file, the build also accepts:
# ARCHIVE_KEYSTORE_FILE
# ARCHIVE_KEYSTORE_PASSWORD
# ARCHIVE_KEY_ALIAS
# ARCHIVE_KEY_PASSWORD
