# Dependencies and generated web builds
node_modules/
dist/

# Logs and test output
*.log
playwright-report/
test-results/
coverage/

# Environment variables and local secrets
.env
.env.*
!.env.example
keystore.properties
**/keystore.properties
google-services.json
**/google-services.json

# Browser automation profiles
edge-cdp-profile/
*-cdp-profile/

# Local development screenshots (curated README images belong in docs/screenshots)
/*.png

# Personal Archive backups and exports
backups/
exports/
*backup*.json
*export*.json

# Android generated and machine-specific files
android/.gradle/
android/**/build/
android/local.properties
android/.idea/
.android/
*.avd/
# Versioned APKs live locally and in Drive; GitHub receives them as release assets.
releases/**/*.apk
releases/**/*.sha256
*.apk
*.aab
*.jks
*.keystore
*.p12
*.pfx
*.pem
*.key

# Editor and operating-system files
.vscode/
.idea/
*.iml
.DS_Store
Thumbs.db
